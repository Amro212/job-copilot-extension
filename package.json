{
  "name": "kareer",
  "version": "0.4.38",
  "description": "Kareer — AI job application autofill for Chrome, Firefox, and Tampermonkey",
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "build": "node tools/build.js",
    "build:userscript": "node tools/build.js --target=userscript",
    "build:extension": "node tools/build.js --target=extension",
    "dev": "node tools/build.js --watch",
    "bump:patch": "node tools/build.js --bump=patch",
    "bump:minor": "node tools/build.js --bump=minor",
    "bump:major": "node tools/build.js --bump=major"
  },
  "keywords": [
    "chrome-extension",
    "firefox-extension",
    "userscript",
    "kareer",
    "autofill"
  ],
  "author": "Kareer Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "selfsigned": "^5.5.0",
    "web-ext": "^10.7.0"
  }
}
