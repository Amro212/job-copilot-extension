{
  "manifest_version": 3,
  "name": "Job Copilot",
  "description": "AI job application autofill with multi-step application support.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["content/index.js"]
    }
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Toggle Job Copilot panel",
    "default_popup": "popup/index.html"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Toggle the Job Copilot panel"
    }
  }
}
